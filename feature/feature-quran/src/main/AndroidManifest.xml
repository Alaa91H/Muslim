<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background recitation downloads (ayah/surah/full Quran) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Exact wake-up for night-only downloads (التحميل الليلي). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service that keeps recitation playing in the background and
         exposes it to the system as media (lock screen + notification shade). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Resume queued downloads automatically after a device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name=".data.QuranDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hosts the MediaSession and a browsable offline-recitation tree for
             Android Auto. The service exposes only downloaded Quran audio. -->
        <service
            android:name=".data.RecitationPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Actions for the recitation control notification (play/pause/stop). -->
        <receiver
            android:name=".data.RecitationActionReceiver"
            android:exported="false" />

        <!-- Headphone / external media-button handling: routes
             ACTION_MEDIA_BUTTON presses (play/pause/next on headsets and
             Bluetooth devices) to the recitation MediaSession. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Pauses the recitation while soundful notifications are showing
             (needs Notification access; harmless when not granted). -->
        <service
            android:name=".data.RecitationPauseOnNotifications"
            android:exported="false"
            android:label="@string/quran_pause_notif_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Restores queued downloads after a device reboot. -->
        <receiver
            android:name=".data.QuranDownloadBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
