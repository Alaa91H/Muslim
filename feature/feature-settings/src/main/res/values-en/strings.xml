    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_license_title">License</string>
    <string name="about_license_body">Muslim is a completely free, open-source app under the GPLv3 license — no ads, no subscriptions, no tracking. Any modified version stays open source.</string>
    <string name="about_principles_title">Our principles</string>
    <string name="about_principles_body">Free forever · Privacy first · Astronomical accuracy in prayer times and qibla · Works offline · Support for juristic schools through customizable settings.</string>
    <string name="about_content_review_title">Religious content review</string>
    <string name="about_content_review_body">Quran, hadith and adhkar texts undergo specialist religious review, separate from code review, before the official release. Quran text source: Tanzil project (Uthmani script).</string>
