    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">A complete, free, open-source companion for every Muslim — prayer times, Adhan, Quran, hadith, adhkar and more, in your language.</string>
    <string name="about_description_title">About Muslim</string>
    <string name="about_description_body">Muslim is a free and open-source Android app that accompanies you throughout the day: astronomically accurate prayer times with the Adhan, a precise Qibla compass, the complete Quran with recitations and tafsir, a hadith library, sourced adhkar, an electronic tasbih, Ramadan tools, a zakat calculator, offline maps, and more — designed to work fully offline with privacy by default.</string>
    <string name="about_features_title">Highlights</string>
    <string name="about_features_body">Everything a Muslim needs in one app:</string>
    <string name="about_feature_prayer">Prayer times &amp; Adhan — all calculation methods, juristic schools, and 18+ adhan sounds</string>
    <string name="about_feature_quran">Complete Quran — Uthmani script, 44 reciters, tafsir, translations, word search &amp; frequency</string>
    <string name="about_feature_adhkar">Adhkar, tasbih, Ramadan &amp; Zakat — with reminders and floating bubbles</string>
    <string name="about_feature_offline">Offline-first — maps, Quran, hadith and adhkar work with no internet</string>
    <string name="about_feature_privacy">Privacy by default — no ads, no tracking, your data stays on your device</string>
    <string name="about_license_title">License</string>
    <string name="about_license_body">Muslim is a completely free, open-source app under the GPLv3 license — no ads, no subscriptions, no tracking. Any modified version stays open source.</string>
    <string name="about_principles_title">Our principles</string>
    <string name="about_principles_body">Free forever · Privacy first · Astronomical accuracy in prayer times and qibla · Works offline · Support for juristic schools through customizable settings.</string>
    <string name="about_content_review_title">Religious content review</string>
    <string name="about_content_review_body">Quran, hadith and adhkar texts undergo specialist religious review, separate from code review, before the official release. Quran text source: Tanzil project (Uthmani script).</string>
    <string name="about_contact_title">Contact the developer</string>
    <string name="about_contact_github">GitHub</string>
    <string name="about_contact_email">Email</string>
    <string name="about_contact_telegram">Telegram</string>
    <string name="about_contact_support">Support development</string>

    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_body">Muslim respects your privacy and does not collect your data.\n\n• No tracking: no ad SDKs, analytics or marketing trackers.\n• Data stays on your device: all your data (location, settings, bookmarks) is stored locally on your device only.\n• Location is used locally: your coordinates are used to calculate prayer times and the qibla on your device, and are never sent to any external server.\n• Permissions only when needed: we ask for permissions (location, notifications) only when a feature actually needs them, with a clear explanation.\n• No forced connectivity: the app works offline; network use is entirely optional for extras such as downloading recitations.\n\nThis policy is part of the open-source repository and is open to community review.</string>

