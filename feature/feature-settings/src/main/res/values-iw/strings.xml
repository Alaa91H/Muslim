    <string name="about_tagline">מלווה מלא, חינמי, בקוד פתוח לכל מוסלמי - זמני תפילה, אדהן, קוראן, חדית\', אדקר ועוד, בשפה שלך.</string>
    <string name="about_description_title">לגבי מוסלמי</string>
    <string name="about_description_body">מוסלמי היא אפליקציית אנדרואיד חינמית וקוד פתוח שמלווה אותך לאורך כל היום: זמני תפילה מדויקים מבחינה אסטרונומית עם האדהאן, מצפן קיבלה מדויק, הקוראן המלא עם דקלומים ותפסיר, ספריית חדית\', אדקר ממקור, טאביח אלקטרוני, כלי רמדאן, מחשבון זכאת, מפות לא מקוונות לעבודה באופן מלא ועוד.</string>
    <string name="about_features_title">הבהרה</string>
    <string name="about_features_body">כל מה שמוסלמי צריך באפליקציה אחת:</string>
    <string name="about_feature_prayer">זמני תפילה ואדהאן - כל שיטות החישוב, בתי הספר למשפטים ו-18+ צלילי אדהן</string>
    <string name="about_feature_quran">הקוראן השלם - תסריט אותמני, 44 מדקלמים, טפסר, תרגומים, חיפוש מילים ותדירות</string>
    <string name="about_feature_adhkar">אדקר, טסביח, רמדאן וזכאת - עם תזכורות ובועות צפות</string>
    <string name="about_feature_offline">לא מקוון-ראשון - מפות, קוראן, חדית\' ו-adhkar פועלות ללא אינטרנט</string>
    <string name="about_feature_privacy">פרטיות כברירת מחדל - ללא מודעות, ללא מעקב, הנתונים שלך נשארים במכשיר שלך</string>
