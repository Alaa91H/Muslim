    <string name="about_tagline">Yon konpayon konplè, gratis, ouvè pou chak Mizilman - fwa lapriyè, Adhan, Koran, adit, adhkar ak plis ankò, nan lang ou.</string>
    <string name="about_description_title">Konsènan Mizilman</string>
    <string name="about_description_body">Mizilman se yon aplikasyon android gratis ak sous ouvè ki akonpaye ou pandan tout jounen an: tan lapriyè egzat astwonomik ak Adhan, yon konpa Qibla egzak, koran konplè a ak resitasyon ak tafsir, yon bibliyotèk adit, adhkar sous, yon tasbih elektwonik, zouti Ramadan, yon kalkilatris zakat, kat offline, ak plis ankò - ki fèt ak travay sou vi prive pa default.</string>
    <string name="about_features_title">Pwen esansyèl</string>
    <string name="about_features_body">Tout sa yon Mizilman bezwen nan yon sèl aplikasyon:</string>
    <string name="about_feature_prayer">Tan lapriyè &amp; Adhan - tout metòd kalkil, lekòl jiridik, ak 18+ son adhan</string>
    <string name="about_feature_quran">Koran konplè - Uthmani script, 44 reciters, tafsir, tradiksyon, rechèch mo ak frekans</string>
    <string name="about_feature_adhkar">Adhkar, tasbih, Ramadan &amp; Zakat - ak rapèl ak bul k ap flote</string>
    <string name="about_feature_offline">Offline-premye - kat, koran, adit ak adhkar travay san entènèt</string>
    <string name="about_feature_privacy">Konfidansyalite pa default - pa gen okenn anons, pa gen okenn swiv, done ou rete sou aparèy ou an</string>
