<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:background="@drawable/notification_prayer_panel"
    android:orientation="vertical"
    android:paddingStart="1dp"
    android:paddingTop="8dp"
    android:paddingEnd="1dp"
    android:paddingBottom="8dp">

    <!--
      Android 12+ always places custom notification content inside a system
      template, so the app cannot remove the outer SystemUI inset. Keep our own
      horizontal inset almost zero to use the full width SystemUI actually gives
      the RemoteViews, especially on narrow Samsung/One UI notification cards.
    -->
    <TextView
        android:id="@+id/notification_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/notification_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/notification_prayer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:layoutDirection="locale"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/notification_prayer_fajr_cell"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/notification_prayer_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingTop="6dp"
            android:paddingEnd="1dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notification_prayer_fajr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_fajr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_fajr_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_muted"
                android:textSize="8sp"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/notification_prayer_fajr_status_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_prayer_dhuhr_cell"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/notification_prayer_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingTop="6dp"
            android:paddingEnd="1dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notification_prayer_dhuhr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_dhuhr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_dhuhr_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_muted"
                android:textSize="8sp"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/notification_prayer_dhuhr_status_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_prayer_asr_cell"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/notification_prayer_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingTop="6dp"
            android:paddingEnd="1dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notification_prayer_asr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_asr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_asr_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_muted"
                android:textSize="8sp"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/notification_prayer_asr_status_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_prayer_maghrib_cell"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/notification_prayer_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingTop="6dp"
            android:paddingEnd="1dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notification_prayer_maghrib_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_maghrib_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_maghrib_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_muted"
                android:textSize="8sp"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/notification_prayer_maghrib_status_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_prayer_isha_cell"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/notification_prayer_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingTop="6dp"
            android:paddingEnd="1dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/notification_prayer_isha_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_isha_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_prayer_isha_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_muted"
                android:textSize="8sp"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/notification_prayer_isha_status_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
