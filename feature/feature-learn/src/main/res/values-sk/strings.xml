    <string name="hajj_companion_arafah_msg">Najväčší pilier: stojte pri Arafahu od poludnia až do západu slnka a robte veľa prosieb, takbir a tahlil. Prorok (PBUH) povedal: "Hajj je Arafah."</string>
    <string name="hajj_companion_arafah_title">Deň Arafahu (9. Dhul-Hijjah)</string>
    <string name="hajj_companion_nahr_msg">Eid al-Adha: kameň Jamarat al-Aqabah so siedmimi kamienkami, obetujte, ohoľte alebo upravte, potom vykonajte Tawaf al-Ifadah a Sai.</string>
    <string name="hajj_companion_nahr_title">Deň An-Nahr (10. Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle">Denné upozornenie, ktoré vám pripomína zamýšľaný obrad v danom čase počas dní hadždž (8–13 Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle_en">Denné upozornenie, ktoré vám pripomína zamýšľaný obrad v danom čase počas dní hadždž (8–13 Dhul-Hijjah)</string>
    <string name="hajj_companion_tarwiyah_msg">Sunna tohto dňa: vstúpte do ihramu, zamierte do Miny a strávte tam noc opakovaním talbiyah „Labbayk Allahumma labbayk“ a modlite sa tam skrátene bez kombinovania.</string>
    <string name="hajj_companion_tarwiyah_title">Deň Tarwiyah (8. Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq1_msg">Po poludní ukameňujte tri Jamaraty: malý, potom stredný, potom veľký, každý po sedem kamienkov, pričom každý hovorí takbir, prosí o malý a stredný.</string>
    <string name="hajj_companion_tashreeq1_title">Dni Tashreeq: 1. deň (11. Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq2_msg">Opakujte ukameňovanie troch Jamaratov po poludní ako včera. Kto sa chce ponáhľať, môže opustiť Minu pred západom slnka; kto zostane, nocuje a na tretí deň kameňuje.</string>
    <string name="hajj_companion_tashreeq2_title">Dni Tashreeq: 2. deň (12. Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq3_msg">Po poludní ukameňujte tri Jamaraty a pri odchode z Mekky ukončite hadždž rozlúčkovým Tawafom. Nech Alah prijme tvoj hadždž.</string>
    <string name="hajj_companion_tashreeq3_title">Dni Tashreeq: 3. deň (13. Dhul-Hijjah)</string>
    <string name="hajj_companion_title">Spoločník pútnik</string>
