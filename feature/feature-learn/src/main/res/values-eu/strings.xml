    <string name="hajj_companion_arafah_msg">Zutaberik handiena: egon Arafahen eguerditik ilunabarrera arte, erregu asko eginez, takbir eta tahlil. Profetak (PBUH) esan zuen: "Hajj Arafah da".</string>
    <string name="hajj_companion_arafah_title">Arafah eguna (9 Dhul-Hijjah)</string>
    <string name="hajj_companion_nahr_msg">Eid al-Adha: harritu Jamarat al-Aqabah zazpi harri-koskorrekin, sakrifizioa eskaini, bizarra edo moztu, gero Tawaf al-Ifadah eta Sai egin.</string>
    <string name="hajj_companion_nahr_title">An-Nahr eguna (10 Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle">Hajj egunetan (8-13 Dhul-Hijjah) bere garaian aurreikusitako erritua gogorarazten dizun eguneroko jakinarazpena.</string>
    <string name="hajj_companion_subtitle_en">Hajj egunetan (8-13 Dhul-Hijjah) bere garaian aurreikusitako erritua gogorarazten dizun eguneroko jakinarazpena.</string>
    <string name="hajj_companion_tarwiyah_msg">Egun honetako sunnah: sartu ihram, joan Minara eta bertan gaua pasa, Talbiyah "Labbayk Allahumma labbayk" errepikatuz, eta bertan otoitz laburtua konbinatu gabe.</string>
    <string name="hajj_companion_tarwiyah_title">Tarwiyah eguna (8 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq1_msg">Harrikatu hiru Jamarat eguerdi ondoren: txikia, gero erdikoa, gero handia, zazpi harri harri bakoitza takbir esanez, txikien eta erdikoen atzetik erregu eginez.</string>
    <string name="hajj_companion_tashreeq1_title">Tashreeq egunak: 1. eguna (11 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq2_msg">Errepikatu hiru Jamarat harrikada eguerdian atzo bezala. Azkartu nahi duenak ilunabarrera baino lehen utzi dezake Mina; geratzen denak gaua eta herenegun harrika egiten du.</string>
    <string name="hajj_companion_tashreeq2_title">Tashreeq egunak: 2. eguna (12 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq3_msg">Harrikatu hiru Jamarat eguerdian, eta gero Hajj-a agurra Tawaf-arekin amaitu Makkah irtetean. Ala onar dezala zure Hajj.</string>
    <string name="hajj_companion_tashreeq3_title">Tashreeq egunak: 3. eguna (13 Dhul-Hijjah)</string>
