    <string name="hajj_companion_tarwiyah_msg">Sunna yimdəye: ihramro gawo, Minaro letə kuru nadən bənye dəga, Talbiyah "Labbayk Allahumma labbayk" dəga waltəm nanatəyin, kuru nadən salat kasarrataro kəltə baro.</string>
    <string name="hajj_companion_tarwiyah_title">Yim Tarwiyahbe (Zulhijjabe 8)</string>
    <string name="hajj_companion_tashreeq1_msg">Jamarat yakkədə ngawo kawudoben: ganadə, daji dawudə, daji kuradə, kawu tulur falnzawoso takbir sədin, ngawo gana-a dawu-aben duwajin.</string>
    <string name="hajj_companion_tashreeq1_title">Kawu Tashriqbe: kawu 1 (Zulhijjabe 11)</string>
    <string name="hajj_companion_tashreeq2_msg">Jamarat yakkədəga waltəm fəletə ngawo kawudoben futu biska yeyi. Ndu yayi duwaro waljiya səraanadə kawu kəngal fəlejinro Mina koljin; ndu yayi dazənadə bəne-a kuru kawu kən yakkəmedən kawu-a sədin.</string>
    <string name="hajj_companion_tashreeq2_title">Kawu Tashriqbe: kawu 2 (Zulhijjabe 12)</string>
    <string name="hajj_companion_tashreeq3_msg">Jamarat yakkədə ngawo kawudoben, daji Hajjdə Tawaf farewellben tamotin loktu Makkah koljinlan. Allah ye Hajj dǝga kasatsǝ.</string>
    <string name="hajj_companion_tashreeq3_title">Kawu Tashriqbe: kawu 3 (Zulhijjabe 13)</string>
