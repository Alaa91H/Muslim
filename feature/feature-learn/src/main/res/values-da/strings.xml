    <string name="hajj_companion_arafah_msg">Den største søjle: stå ved Arafah fra efter middag til solnedgang og frembyde meget bøn, takbir og tahlil. Profeten (PBUH) sagde: "Hajj er Arafah."</string>
    <string name="hajj_companion_arafah_title">Arafahs dag (9 Dhul-Hijjah)</string>
    <string name="hajj_companion_nahr_msg">Eid al-Adha: Sten Jamarat al-Aqabah med syv småsten, offer offeret, barber eller trim, udfør derefter Tawaf al-Ifadah og Sai.</string>
    <string name="hajj_companion_nahr_title">An-Nahrs dag (10 Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle">En daglig meddelelse, der minder dig om den påtænkte rite på dets tidspunkt i Hajj-dagene (8-13 Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle_en">En daglig meddelelse, der minder dig om den påtænkte rite på dets tidspunkt i Hajj-dagene (8-13 Dhul-Hijjah)</string>
    <string name="hajj_companion_tarwiyah_msg">Dagens sunnah: gå ind i ihram, gå til Mina og tilbring natten der, gentag Talbiyah "Labbayk Allahumma labbayk", og bed der forkortet uden at kombinere.</string>
    <string name="hajj_companion_tarwiyah_title">Tarwiyahs dag (8 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq1_msg">Sten de tre Jamarat efter middag: den lille, så den mellemste, så den store, syv småsten hver, mens du siger takbir og bønfalder efter de små og mellemste.</string>
    <string name="hajj_companion_tashreeq1_title">Days of Tashreeq: dag 1 (11 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq2_msg">Gentag steningen af de tre Jamarat efter middag som i går. Den, der ønsker at skynde sig, kan forlade Mina før solnedgang; den, der bliver, overnatter og stener på den tredje dag.</string>
    <string name="hajj_companion_tashreeq2_title">Days of Tashreeq: dag 2 (12 Dhul-Hijjah)</string>
    <string name="hajj_companion_tashreeq3_msg">Sten de tre Jamarat efter middag, og afslut derefter Hajj med farvel Tawaf, når du forlader Mekka. Må Allah acceptere din Hajj.</string>
    <string name="hajj_companion_tashreeq3_title">Days of Tashreeq: dag 3 (13 Dhul-Hijjah)</string>
    <string name="hajj_companion_title">Pilgrimsfælle</string>
