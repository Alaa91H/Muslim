    <string name="hajj_companion_arafah_msg">העמוד הכי גדול: עומדים בערבה משעות הצהריים ועד השקיעה, מתפללים הרבה, תביר ותהליל. הנביא (ה\') אמר: "חאג\' הוא ערפה".</string>
    <string name="hajj_companion_arafah_title">יום ערפה (9 ד\'ול-היג\'ה)</string>
    <string name="hajj_companion_nahr_msg">עיד אל-אדחה: אבנים את ג\'מארת אל-עקבה עם שבעה חלוקי נחל, מקריבים את הקורבן, מגלחים או גזוזים, ואז מבצעים את תוואף אל-איפאדה וסאי.</string>
    <string name="hajj_companion_nahr_title">יום אן-נהר (10 ד\'ול-היג\'ה)</string>
    <string name="hajj_companion_subtitle">הודעה יומית המזכירה לך את הטקס המיועד בזמן שלו במהלך ימי החאג\' (8-13 Dhul-Hijjah)</string>
    <string name="hajj_companion_subtitle_en">הודעה יומית המזכירה לך את הטקס המיועד בזמן שלו במהלך ימי החאג\' (8-13 Dhul-Hijjah)</string>
    <string name="hajj_companion_tarwiyah_msg">הסונה של היום הזה: היכנסו לאיהראם, סעו למינה ותעבירו שם את הלילה, חוזרים על הטלביה "לאבאיק אללהומה לבאייק", ומתפללים שם מקוצר מבלי לשלב.</string>
    <string name="hajj_companion_tarwiyah_title">יום תרוויה (8 דהול-היג\'ה)</string>
    <string name="hajj_companion_tashreeq1_msg">אבנים את שלושת הג\'מארת אחרי הצהריים: הקטן, אחר כך האמצעי, ואז הגדול, שבעה חלוקי נחל כל אחד תוך אמירת תביר, מתחננים אחרי הקטנים והאמצעיים.</string>
    <string name="hajj_companion_tashreeq1_title">ימי תשרק: יום 1 (11 ד\'ול-היג\'ה)</string>
    <string name="hajj_companion_tashreeq2_msg">חזור על סקילה של שלושת הג\'מאראט אחרי הצהריים כמו אתמול. מי שרוצה למהר רשאי לעזוב את מינה לפני השקיעה; מי שנשאר מבלה את הלילה ומאבנים ביום השלישי.</string>
    <string name="hajj_companion_tashreeq2_title">ימי תשרק: יום 2 (12 ד\'ול-היג\'ה)</string>
    <string name="hajj_companion_tashreeq3_msg">אבנים את שלושת הג\'מאראט אחרי הצהריים, ואז סיים את החאג\' עם הפרידה טוואף כשיוצאים ממכה. שאללה יקבל את החאג\' שלך.</string>
    <string name="hajj_companion_tashreeq3_title">ימי תשרק: יום 3 (13 Dhul-Hijjah)</string>
