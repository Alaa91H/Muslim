    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crescent: outer circle minus the offset inner circle (evenOdd). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,39 a21,21 0 1,0 0,42 a21,21 0 1,0 0,-42 z M63,43 a17,17 0 1,0 0,34 a17,17 0 1,0 0,-34 z" />

    <!-- Gold four-point star in the crescent's opening. -->
    <path
        android:fillColor="#FFFFC93C"
        android:pathData="M76,44 L77.3,48.7 L82,50 L77.3,51.3 L76,56 L74.7,51.3 L70,50 L74.7,48.7 Z" />
</vector>
