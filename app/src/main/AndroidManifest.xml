<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for every optional download (recitation audio, extra adhan
         sounds, translation/tafsir packs). All downloads are user-initiated. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep the device awake while a background service/alarm receiver does
         short work (adhan playback, downloads, notification refresh). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Used only after an explicit tap on the accessibility voice-navigation control. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Required on Android 11+ to discover a system speech-recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Ask the user to exempt the app from battery optimization so prayer
         times, adhan and reminders stay reliable around the clock on OEM
         devices that aggressively kill background work. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MuslimApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_muslim_launcher_v2028"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_muslim_launcher_round_v2028"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muslim">

        <service
            android:name="org.muslim.app.feature.quran.data.RecitationPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <service
            android:name=".wear.WearCompanionDataService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/muslim/wear/tasbih/increment/v1" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.wearable.capability"
            android:value="muslim_wear_companion_v1" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name=".IconIdentityMigrationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Shortcuts deep-link into the matching bottom tab. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="muslim" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>
