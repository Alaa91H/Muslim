# Default: normalize line endings for all text files (CRLF->LF in the repo).
* text=auto

# --- Canonical line endings: LF (the repository stores LF everywhere) ---
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.json   text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro    text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.html   text eol=lf
*.css    text eol=lf

# Shell scripts: LF (executables must stay LF).
*.sh     text eol=lf
gradlew  text eol=lf

# Windows batch: conventional CRLF on checkout (stored as LF in the repo).
*.bat    text eol=crlf
*.cmd    text eol=crlf

# --- Binary files: never convert, never diff as text ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.svg    binary
*.mp3    binary
*.ogg    binary
*.wav    binary
*.m4a    binary
*.gz     binary
*.zip    binary
*.jar    binary
*.aar    binary
*.apk    binary
*.keystore binary
*.jks    binary
*.ttf    binary
*.otf    binary
*.db     binary
*.sqlite binary
*.bin    binary
