# Release signing configuration — copy this file to keystore.properties
# (which is git-ignored) and fill in the values for your own keystore.
# Without it, the release build falls back to the debug key so it still
# produces an installable APK (suitable for testing, not for Play Store).
storeFile=C:/path/to/your/release.keystore
storePassword=change-me
keyAlias=manara
keyPassword=change-me
