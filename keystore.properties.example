# Release signing configuration — never commit the real keystore.properties.
#
# Easiest path: generate everything automatically (keystore + these 4 values):
#   ./scripts/create-signing-keystore.sh
# Then share the same key with CI once:
#   ./scripts/setup-github-signing.sh
#
# Manual alternative: copy this file to keystore.properties and fill in the
# values for your own keystore. Without it, the release build falls back to the
# debug key so it still produces an installable APK (suitable for testing, not
# for Play Store). CI can also supply the values as env secrets
# (SIGNING_KEYSTORE base64, SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS,
# SIGNING_KEY_PASSWORD) — same key, one stable signature for updates.
storeFile=C:/path/to/your/release.keystore
storePassword=change-me
keyAlias=muslim
keyPassword=change-me
